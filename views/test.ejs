<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        header {
    background: rgba(10, 10, 31, 0.8);
    backdrop-filter: blur(10px);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
}

.logo-img {
    width: 50px;
    height: 50px;
    margin-right: 10px;
}

.logo-text {
    font-size: 24px;
    font-weight: bold;
    color: #FF3366; /* Change to your preferred color */
}

nav ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    position: relative;
}

nav ul li a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #FF3366; /* Change to your preferred color */
    transition: width 0.3s ease;
}

nav ul li a:hover::after {
    width: 100%;
}

.search-bar {
    display: flex;
    align-items: center;
}

.search-bar input {
    padding: 8px;
    border: none;
    border-radius: 4px;
    margin-right: 10px;
}

.search-bar button {
    padding: 8px 12px;
    background: #FF3366; /* Change to your preferred color */
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.hamburger-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
}

.hamburger-menu span {
    width: 25px;
    height: 3px;
    background: #fff;
    transition: all 0.3s ease;
}

/* Responsive Styles */
@media screen and (max-width: 768px) {
    nav ul {
        display: none; /* Hide original nav */
        flex-direction: column;
        position: absolute;
        top: 60px;
        right: 0;
        background: rgba(10, 10, 31, 0.9);
        width: 100%;
        padding: 20px;
        z-index: 999;
    }

    nav ul.active {
        display: flex; /* Show nav when active */
    }

    .hamburger-menu {
        display: flex; /* Show hamburger menu */
    }

    .search-bar {
        display: none; /* Hide search bar on mobile */
    }
}
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <img class="logo-img" src="https://i.ibb.co/d42CsCQ/logo.webp" alt="Logo">
            <div class="logo-text">Campus Papers</div>
        </div>
    
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/all_papers">Exam Papers</a></li>
                <li><a href="/notes">Notes</a></li>
                <li><a href="/coding_resources">Coding Resources</a></li>
                <li><a href="/contribute">Contribute</a></li>
                <li><a href="/feedback">Feedback</a></li>
            </ul>
        </nav>
    
        <div class="search-bar">
            <input type="text" placeholder="Search...">
            <button>Search</button>
        </div>
    
        <div class="hamburger-menu">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </header>
</body>
<script>
    
    const hamburger = document.querySelector('.hamburger-menu');
    const nav = document.querySelector('nav ul');

    hamburger.addEventListener('click', () => {
        nav.classList.toggle('active');
        hamburger.classList.toggle('active');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
        if (!nav.contains(e.target) && !hamburger.contains(e.target)) {
            nav.classList.remove('active');
            hamburger.classList.remove('active');
        }
    });

</script>
</html>