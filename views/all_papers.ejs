<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IIT Papers</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #0A0A1F;
            color: #fff;
            min-height: 100vh;
        }

        /* Neural Network Animation Background */
        .neural-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0.15;
            background: 
                radial-gradient(circle at 10% 20%, #FF3366 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, #6B46C1 0%, transparent 20%),
                radial-gradient(circle at 50% 50%, #3B82F6 0%, transparent 30%);
            filter: blur(80px);
            animation: bgPulse 8s ease infinite;
        }

        @keyframes bgPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Institute Sections */
        .institute-section {
            margin: 40px auto;
            padding: 20px;
            max-width: 1400px;
            opacity: 0;
            transform: translateY(20px);
            animation: sectionFadeIn 0.8s ease forwards;
        }

        .institute-heading {
            font-size: 2.5em;
            text-align: center;
            margin-bottom: 40px;
            position: relative;
            padding-bottom: 15px;
        }

        .nit-section .institute-heading {
            background: linear-gradient(45deg, #FF3366, #FF6B6B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .iit-section .institute-heading {
            background: linear-gradient(45deg, #6B46C1, #9B6BFF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .institute-heading::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 150px;
            height: 4px;
            border-radius: 2px;
        }

        .nit-section .institute-heading::after {
            background: linear-gradient(90deg, #FF3366, #FF6B6B);
        }

        .iit-section .institute-heading::after {
            background: linear-gradient(90deg, #6B46C1, #9B6BFF);
        }

        /* Papers Grid */
        .papers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            padding: 20px;
        }

        .paper-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .nit-section .paper-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 51, 102, 0.2);
            border-color: #FF3366;
        }

        .iit-section .paper-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(107, 70, 193, 0.2);
            border-color: #6B46C1;
        }

        .paper-card h3 {
            font-size: 1.2em;
            margin-bottom: 15px;
            color: #fff;
        }

        .paper-info {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            font-size: 0.9em;
            color: rgba(255, 255, 255, 0.7);
        }

        .paper-tag {
            background: rgba(255, 255, 255, 0.1);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8em;
        }

        .download-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .nit-section .download-btn {
            background: linear-gradient(45deg, #FF3366, #FF6B6B);
        }

        .iit-section .download-btn {
            background: linear-gradient(45deg, #6B46C1, #9B6BFF);
        }

        .download-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

        /* Responsive Design */
        @media screen and (max-width: 768px) {
            .institute-heading {
                font-size: 2em;
            }

            .papers-grid {
                grid-template-columns: 1fr;
                padding: 10px;
            }

            .paper-card {
                padding: 20px;
            }
        }

        /* Animation */
        @keyframes sectionFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="neural-bg"></div>

