<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Campus Papers</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            background: #0F172A;
            position: relative;
            overflow: hidden;
        }

        /* Animated background */
        body::before {
            content: '';
            position: absolute;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                #FF3366,
                #6B46C1,
                #3B82F6,
                #10B981
            );
            animation: bgAnimation 15s linear infinite;
            opacity: 0.1;
        }

        @keyframes bgAnimation {
            0% {
                transform: translateX(-50%) translateY(-50%) rotate(0deg);
            }
            100% {
                transform: translateX(-50%) translateY(-50%) rotate(360deg);
            }
        }

        /* Floating shapes */
        .shapes {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }

        .shape {
            position: absolute;
            filter: blur(1px);
            opacity: 0.2;
        }

        .shape:nth-child(1) {
            top: 20%;
            left: 10%;
            width: 100px;
            height: 100px;
            background: #FF3366;
            animation: float 8s infinite;
        }

        .shape:nth-child(2) {
            top: 60%;
            right: 15%;
            width: 150px;
            height: 150px;
            background: #6B46C1;
            animation: float 12s infinite;
        }

        .shape:nth-child(3) {
            bottom: 20%;
            left: 20%;
            width: 80px;
            height: 80px;
            background: #3B82F6;
            animation: float 10s infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }

        .login-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            padding: clamp(20px, 5vw, 40px);
            border-radius: 24px;
            width: min(90%, 400px);
            position: relative;
            z-index: 2;
            border: 1px solid rgba(255, 255, 255, 0.1);
            animation: containerAppear 1s ease-out;
            box-shadow: 
                0 0 40px rgba(0, 0, 0, 0.3),
                inset 0 0 20px rgba(255, 255, 255, 0.05);
        }

        @keyframes containerAppear {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            font-size: clamp(1.8em, 5vw, 2.5em);
            margin-bottom: clamp(20px, 4vw, 30px);
            text-align: center;
            background: linear-gradient(45deg, #FF3366, #6B46C1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: titlePulse 2s infinite alternate;
        }

        @keyframes titlePulse {
            0% { filter: drop-shadow(0 0 2px rgba(255, 51, 102, 0.3)); }
            100% { filter: drop-shadow(0 0 8px rgba(255, 51, 102, 0.6)); }
        }

        .input-group {
            position: relative;
            margin-bottom: clamp(20px, 4vw, 30px);
        }

        .input-group input {
            width: 100%;
            padding: clamp(12px, 3vw, 15px);
            font-size: clamp(0.9em, 2.5vw, 1em);
            background: rgba(255, 255, 255, 0.07);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #fff;
            outline: none;
            transition: all 0.3s ease;
        }

        .input-group input:focus {
            border-color: #FF3366;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.3);
        }

        .input-group label {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-size: clamp(0.8em, 2.5vw, 0.9em);
            color: rgba(255, 255, 255, 0.6);
            pointer-events: none;
            transition: 0.3s ease all;
        }

        .input-group input:focus + label,
        .input-group input:not(:placeholder-shown) + label {
            top: 0;
            transform: translateY(-170%);
            font-size: 0.8em;
            color: #FF3366;
        }

        button {
            width: 100%;
            padding: clamp(12px, 3vw, 15px);
            background: linear-gradient(45deg, #FF3366, #6B46C1);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: clamp(1em, 2.5vw, 1.1em);
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(255, 51, 102, 0.4);
        }

        button::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(255, 255, 255, 0.2),
                transparent
            );
            transform: rotate(45deg);
            animation: buttonShine 3s infinite;
        }

        .signup-link {
            text-align: center;
            margin-top: clamp(15px, 3vw, 20px);
            font-size: clamp(0.9em, 2.5vw, 1em);
        }

        a {
            color: #FF3366;
            text-decoration: none;
            font-weight: 500;
            transition: 0.3s ease color;
        }

        a:hover {
            color: #6B46C1;
            text-decoration: underline;
        }

        /* Add touch device optimizations */
        @media (hover: none) {
            button:active {
                transform: scale(0.98);
                background: linear-gradient(45deg, #3e3eff, #713eff);
            }
            
            input:focus {
                font-size: 16px; /* Prevents zoom on iOS */
            }
        }

        /* Mobile-specific adjustments */
        @media screen and (max-width: 480px) {
            body {
                background: linear-gradient(45deg, #0a0a0a, #151515);
            }

            .login-container {
                margin: 10px;
                padding: 20px;
            }

            .input-group input:focus + label,
            .input-group input:not(:placeholder-shown) + label {
                transform: translateY(-140%);
            }

            button {
                margin-top: 10px;
                padding: 12px;
            }

            /* Improve touch targets */
            a {
                padding: 8px;
                display: inline-block;
            }
        }

        /* Landscape mode adjustments */
        @media screen and (max-height: 600px) and (orientation: landscape) {
            body {
                min-height: 100vh;
                padding: 20px 0;
            }

            .login-container {
                margin: auto;
                max-height: 90vh;
                overflow-y: auto;
            }

            h2 {
                margin-bottom: 15px;
            }

            .input-group {
                margin-bottom: 15px;
            }
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            .login-container {
                background: rgba(0, 0, 0, 0.2);
            }
        }

        /* High contrast mode */
        @media (prefers-contrast: high) {
            .login-container {
                border: 2px solid #fff;
            }

            input {
                border: 2px solid #fff;
            }
        }

        /* Reduced motion preferences */
        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Add floating shapes -->
    <div class="shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="login-container">
        <h2>Welcome Back</h2>
        <form action="/post_login" method="post">
            <div class="input-group">
                <input type="email" name="email" id="email" placeholder=" " required>
                <label for="email">Email Address</label>
            </div>
            
            <div class="input-group">
                <input type="password" name="password" id="password" placeholder=" " required>
                <label for="password">Password</label>
            </div>
            
            <button type="submit">Login</button>
        </form>
        <div class="signup-link">
            Don't have an account? <a href="/signup">Sign Up</a>
        </div>
    </div>

</body>
<script>
    const form = document.querySelector('form');
    form.addEventListener('submit', (event) => {
        const emailInput = document.querySelector('input[name="email"]').value;
        // const emailRegex = /^[a-zA-Z0-9._%+-]+\.ug23\.cs@nitp\.ac\.in$/;
        // For Gmail addresses
        const emailRegex = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;


        if (!emailRegex.test(emailInput)) {
            event.preventDefault(); // Stop form submission
            
            // Create custom alert element
            const alertDiv = document.createElement('div');
            alertDiv.style.cssText = `
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                padding: 15px 25px;
                background-color: #fee2e2;
                border: 1px solid #ef4444;
                border-radius: 8px;
                color: #991b1b;
                font-size: 14px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                z-index: 1000;
                animation: slideIn 0.3s ease-out;
            `;
            
            alertDiv.textContent = "Only emails ending with '@gmail.com' are allowed.";
            document.body.appendChild(alertDiv);

            // Add animation keyframes
            const style = document.createElement('style');
            style.textContent = `
                @keyframes slideIn {
                    from {
                        transform: translate(-50%, -100%);
                        opacity: 0;
                    }
                    to {
                        transform: translate(-50%, 0);
                        opacity: 1;
                    }
                }
            `;
            document.head.appendChild(style);

            // Remove alert after 3 seconds
            setTimeout(() => {
                alertDiv.style.opacity = '0';
                alertDiv.style.transition = 'opacity 0.3s ease-out';
                setTimeout(() => alertDiv.remove(), 300);
            }, 3000);
        }
    });
</script>

</html>
