                line-height: 1.2;
            }

            .visitor-text span {
                font-size: 14px;
                opacity: 0.8;
            }

            .visitor-text strong {
                font-size: 20px;
                background: linear-gradient(45deg, #ff6b6b, #ff8e8e);
