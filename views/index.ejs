<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previous Year Papers</title>
    <link rel="stylesheet" href="styles.css">
</head>
<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #121212;  /* Darker black background */
        color: #E6D5B8;  /* Light brown text */
    }

    .logo {
        display: flex;
        animation: fadeInRight 0.8s ease forwards;
    }

    .logo-text {
        font-size: 30px;
        font-weight: bold;
        margin-left: 20px;
        color: #C4A484;  /* Brown shade for logo text */
    }

    .logo-img {
        width: 70px;
        height: 70px;
    }

    header {
        margin-top: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 25px;
        background-color: #1E1E1E;  /* Slightly lighter black */
        border-bottom: 2px solid #8B4513;  /* Brown border */
        @media screen and (max-width: 600px) {
            flex-direction: column;
        }
    }

    nav ul {
        list-style-type: none;
        display: flex;
        gap: 15px;
        display: flex;
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.2s;
        opacity: 0;
        @media screen and (max-width: 600px) {
            flex-direction: column;
        }
    }

    nav ul li a {
        color: #DEB887;  /* Burly wood color for nav links */
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    nav ul li a:hover {
        color: #D2691E;  /* Chocolate brown on hover */
    }

    .search-bar input {
        padding: 8px 15px;
        margin-right: 10px;
        background-color: #2D2D2D;
        border: 1px solid #8B4513;
        color: #E6D5B8;
        border-radius: 4px;
    }

    .search-bar button {
        padding: 8px 15px;
        background-color: #8B4513;
        color: #E6D5B8;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .search-bar button:hover {
        background-color: #A0522D;
    }

    h1 {
        text-align: center;
        margin-top: 30px;
        color: #DEB887;
        font-size: 2.2em;
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.8s;
        opacity: 0;
    }

    .papers-list {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 25px;
        padding: 20px;
        margin-bottom: 60px;
    }

    .paper-card {
        border: 1px solid #8B4513;
        padding: 20px;
        width: 250px;
        text-align: center;
        background-color: #1E1E1E;
        border-radius: 8px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 6px rgba(139, 69, 19, 0.1);
        animation: fadeInUp 0.8s ease forwards;
        opacity: 0;
    }

    .paper-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(139, 69, 19, 0.2);
    }

    .paper-card h3 {
        color: #DEB887;
        margin-bottom: 15px;
        font-size: 1.2em;
    }

    .paper-card p {
        color: #BC8F8F;  /* Rosy brown */
        margin-bottom: 20px;
        font-size: 0.9em;
    }

    .paper-card button {
        background-color: #8B4513;
        color: #E6D5B8;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        font-weight: bold;
    }

    .paper-card button:hover {
        background-color: #A0522D;
    }

    footer {
        text-align: center;
        padding: 15px;
        background-color: #1E1E1E;
        color: #DEB887;
        position: fixed;
        width: 100%;
        bottom: 0;
        border-top: 2px solid #8B4513;
        animation: fadeInUp 0.8s ease forwards;
        animation-delay: 1.6s;
        opacity: 0;
    }

    .user-info {
        color: #DEB887;
        font-size: 1.1em;
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.4s;
        opacity: 0;
    }

    .user-info strong {
        color: #D2691E;
    }

    .preview-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
        background-color: #fff;
        margin: 15% auto;
        padding: 20px;
        width: 80%;
        position: relative;
    }

    .modal-content iframe {
        width: 100%;
    }

    .close {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 25px;
        cursor: pointer;
    }

    /* Add these new animation keyframes and styles */
    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInRight {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Apply animations to elements */
    .logo {
        animation: fadeInRight 0.8s ease forwards;
    }

    nav ul {
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.2s;
        opacity: 0;
        /* ... existing nav ul styles ... */
    }

    .user-info {
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.4s;
        opacity: 0;
        /* ... existing user-info styles ... */
    }

    .search-bar {
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.6s;
        opacity: 0;
        /* ... existing search-bar styles ... */
    }

    h1 {
        animation: fadeInDown 0.8s ease forwards;
        animation-delay: 0.8s;
        opacity: 0;
        /* ... existing h1 styles ... */
    }

    .paper-card {
        animation: fadeInUp 0.8s ease forwards;
        opacity: 0;
        /* ... existing paper-card styles ... */
    }

    /* Add different delays for each paper card */
    .papers-list .paper-card:nth-child(1) { animation-delay: 1.0s; }
    .papers-list .paper-card:nth-child(2) { animation-delay: 1.1s; }
    .papers-list .paper-card:nth-child(3) { animation-delay: 1.2s; }
    .papers-list .paper-card:nth-child(4) { animation-delay: 1.3s; }
    .papers-list .paper-card:nth-child(5) { animation-delay: 1.4s; }
    .papers-list .paper-card:nth-child(6) { animation-delay: 1.5s; }

    footer {
        animation: fadeInUp 0.8s ease forwards;
        animation-delay: 1.6s;
        opacity: 0;
        /* ... existing footer styles ... */
    }

    /* Responsive navbar styles */
    .menu-toggle {
        display: none;
        flex-direction: column;
        gap: 6px;
        cursor: pointer;
        z-index: 1000;
    }

    .menu-toggle span {
        width: 30px;
        height: 3px;
        background: #DEB887;
        transition: all 0.3s ease;
        border-radius: 2px;
    }

    .menu-toggle.active span:nth-child(1) {
        transform: rotate(45deg) translate(8px, 8px);
    }

    .menu-toggle.active span:nth-child(2) {
        opacity: 0;
    }

    .menu-toggle.active span:nth-child(3) {
        transform: rotate(-45deg) translate(8px, -8px);
    }

    @media screen and (max-width: 768px) {
        header {
            padding: 15px;
            position: relative;
        }

        .menu-toggle {
            display: flex;
        }

        nav {
            position: fixed;
            top: 0;
            right: -100%;
            height: 100vh;
            width: 70%;
            background: rgba(30, 30, 30, 0.98);
            backdrop-filter: blur(10px);
            transition: right 0.3s ease;
            z-index: 999;
        }

        nav.active {
            right: 0;
        }

        nav ul {
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 20px;
            gap: 30px;
        }

        nav ul li a {
            font-size: 1.2em;
        }

        .search-bar {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            padding: 10px;
            background: rgba(30, 30, 30, 0.9);
            backdrop-filter: blur(5px);
            display: none;
        }

        .search-bar.active {
            display: flex;
        }

        .user-info {
            display: none;
        }

        .logo {
            flex: 1;
            justify-content: center;
        }

        .logo-text {
            font-size: 24px;
        }

        .logo-img {
            width: 50px;
            height: 50px;
        }
    }

    /* Mobile-specific paper card styles */
    @media screen and (max-width: 480px) {
        .papers-list {
            padding: 10px;
            gap: 15px;
        }

        .paper-card {
            width: 100%;
            margin: 0;
            padding: 15px;
            animation: slideUp 0.5s ease forwards;
            opacity: 0;
        }

        .paper-card h3 {
            font-size: 1.1em;
        }

        .paper-card p {
            font-size: 0.9em;
        }

        .paper-card button {
            width: 100%;
            padding: 12px;
        }
    }

    /* Tablet styles */
    @media screen and (min-width: 481px) and (max-width: 768px) {
        .papers-list {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
    }

    /* Animation keyframes */
    @keyframes slideUp {
        from {
            transform: translateY(50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Hamburger Menu Button */
    .hamburger-menu {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 22px;
        cursor: pointer;
        z-index: 1000;
        margin-left: auto; /* This will push it to the right */
    }

    .hamburger-menu span {
        display: block;
        height: 3px;
        width: 100%;
        background-color: #DEB887;
        border-radius: 3px;
        transition: all 0.3s ease-in-out;
    }

    .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        right: -100%;
        width: 70%;
        height: 100vh;
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(10px);
        z-index: 999;
        transition: right 0.3s ease-in-out;
        padding-top: 80px;
    }

    @media screen and (max-width: 768px) {
        .hamburger-menu {
            display: flex;
        }

        nav > ul {
            display: none; /* Hide original nav */
        }

        .mobile-nav {
            display: block;
        }

        .mobile-nav.active {
            right: 0;
        }

        .hamburger-menu.active span:nth-child(1) {
            transform: translateY(9px) rotate(45deg);
        }

        .hamburger-menu.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger-menu.active span:nth-child(3) {
            transform: translateY(-9px) rotate(-45deg);
        }

        .search-bar {
            display: none; /* Hide search bar on mobile */
        }

        .user-info {
            display: none; /* Hide user info on mobile */
        }
    }

    /* Add these styles for the year sections */
    .year-section {
        margin: 40px 0;
        padding: 20px;
        opacity: 0;
        transform: translateY(20px);
        animation: sectionFadeIn 0.8s ease forwards;
    }

    .year-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .year-heading {
        font-size: 2em;
        margin-bottom: 30px;
        text-align: center;
        background: linear-gradient(45deg, #FF3366, #6B46C1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        padding-bottom: 10px;
    }

    .year-heading::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 3px;
        background: linear-gradient(90deg, #FF3366, #6B46C1);
        border-radius: 2px;
    }

    .papers-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        padding: 20px;
    }

    @keyframes sectionFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Year-specific accent colors */
    .first-year {
        --accent-color-1: #FF3366;
        --accent-color-2: #FF6B6B;
    }

    .second-year {
        --accent-color-1: #6B46C1;
        --accent-color-2: #9B6BFF;
    }

    .third-year {
        --accent-color-1: #3B82F6;
        --accent-color-2: #60A5FA;
    }

    .fourth-year {
        --accent-color-1: #10B981;
        --accent-color-2: #34D399;
    }

    .year-section .paper-card {
        border-color: var(--accent-color-1);
    }

    .year-section .paper-card button {
        background: linear-gradient(45deg, var(--accent-color-1), var(--accent-color-2));
    }

    .year-section .year-heading {
        background: linear-gradient(45deg, var(--accent-color-1), var(--accent-color-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
<body>
    <header>
    <div class="visitor-count">
        <div class="visitor-icon">👥</div>
        <div class="visitor-text">
            <span>Total Visitors</span>
            <strong class="counter"><%= visitCount %></strong>
        </div>
        <style>
            .visitor-count {
                display: flex;
                align-items: center;
                gap: 12px;
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                padding: 10px 20px;
                border-radius: 50px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                animation: slideIn 0.8s ease forwards;
            }

            .visitor-icon {
                font-size: 24px;
                animation: bounce 2s infinite;
            }

            .visitor-text {
                display: flex;
